[Unit]
Description=BOINC client
Documentation=https://boinc.berkeley.edu/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Nice=10
CPUWeight=idle
IOWeight=25
OOMScoreAdjust=400
Restart=on-failure
RestartSec=10
TimeoutStartSec=60
WorkingDirectory=%h/.local/share/boinc
# Mesa Rusticl hides a driver until it is named here. radeonsi is Navi
# (7900 XTX, 6500, 680M). r600 is the Caicos Radeon HD 7450. Without
# the matching name the client loads libOpenCL and finds no device.
Environment=RUSTICL_ENABLE=radeonsi,r600
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/boinc
ExecStart=/usr/local/bin/boinc --dir %h/.local/share/boinc --allow_remote_gui_rpc
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/bin/rm -f %h/.local/share/boinc/lockfile

[Install]
WantedBy=default.target
