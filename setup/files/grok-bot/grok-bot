#!/usr/bin/env bash
# The AppImage runtime sets APPIMAGE. Grok Bot then rewrites its desktop
# file to launch that AppImage with no arguments. This session's desktop
# name contains KDE, so that launch selects KWallet and cannot read the
# login stored in gnome-keyring. Start the extracted binary instead, with
# APPIMAGE unset, so the rewrite does not run.
set -euo pipefail

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
payload="${data_home}/grok-bot/payload"
bin="${payload}/grok-bot"

usage() {
    cat <<EOF
Usage: grok-bot [--help]
       grok-bot [arguments passed to Grok Bot]

Starts Grok Bot. The AppImage does not print usage.
The login is stored in the gnome-keyring login keyring.
EOF
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
esac

if [[ ! -x "$bin" ]]; then
    printf 'grok-bot: missing %s\n' "$bin" >&2
    exit 127
fi

export PATH="${payload}:${payload}/usr/sbin${PATH:+:${PATH}}"
export XDG_DATA_DIRS="${payload}/usr/share/${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}:/usr/share/gnome:/usr/local/share/:/usr/share/"
export LD_LIBRARY_PATH="${payload}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export GSETTINGS_SCHEMA_DIR="${payload}/usr/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:${GSETTINGS_SCHEMA_DIR}}"
unset APPIMAGE APPDIR ARGV0

extra=()
# Match the AppImage AppRun: without user namespaces the bundled
# Chromium sandbox cannot start.
if ! unshare -Ur true >/dev/null 2>&1; then
    extra+=(--no-sandbox)
fi

exec "$bin" --password-store=gnome-libsecret "${extra[@]}" "$@"
